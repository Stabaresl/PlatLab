# Copiar este archivo como .env y completar con valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

# Django
SECRET_KEY=changeme-genera-una-clave-segura
# Clave de las flags y respuestas de examen (HMAC). Vacía = se deriva de
# SECRET_KEY. Si rotas SECRET_KEY, pon aquí la anterior para que las flags ya
# guardadas sigan validando (platlab.ps1 / platlab.sh lo hacen solos).
FLAG_HASH_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En producción, usar un slug no adivinable (termina en /) en vez de "admin/".
DJANGO_ADMIN_URL=admin/

# --- Solo producción (docker-compose.prod.yml) ---
# Hostname público del backend, sin protocolo (Caddyfile lo usa para pedir
# el certificado HTTPS automático). Con sslip.io: "<ip-con-guiones>.sslip.io".
# Con dominio propio: "api.tudominio.com" (+ registro DNS tipo A -> IP de la VPS).
PUBLIC_HOSTNAME=changeme.sslip.io

# PostgreSQL
POSTGRES_DB=platlab
POSTGRES_USER=platlab
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Email (dev usa consola por defecto, no requiere estas variables)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=changeme
# EMAIL_HOST_PASSWORD=changeme
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@platlab.local

# OAuth2 (Google / GitHub) — client_secret NUNCA se versiona (seguridad.md §9)
GOOGLE_OAUTH_CLIENT_ID=changeme
GOOGLE_OAUTH_CLIENT_SECRET=changeme
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=changeme
GITHUB_OAUTH_CLIENT_SECRET=changeme
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/github/callback


# --- Instalación local / aula (platlab.ps1 / platlab.sh) ---
# Los escribe el instalador; se pueden cambiar a mano y luego "platlab iniciar".
# PLATLAB_MODO: local (solo este equipo, cuentas demo) | red (aula, sin cuentas demo)
PLATLAB_MODO=local
# Puerto por el que se entra a la plataforma (http://localhost:8080)
PLATLAB_PORT=8080
# 127.0.0.1 = solo este equipo · 0.0.0.0 = cualquiera en la red local
PLATLAB_BIND=127.0.0.1

# Capacidad (opcional): procesos del servidor web, workers de Celery y
# aprovisionamientos de laboratorio en paralelo.
# WEB_CONCURRENCY=4
# CELERY_CONCURRENCY=4
# LAB_ENV_PROVISION_CONCURRENCY=20
# LAB_ENV_MAX_CONCURRENTES=120
