.git
.gitignore
.gitattributes
venv/
env/
.venv/
__pycache__/
*.pyc
db.sqlite3
.env
.pytest_cache/
.coverage
htmlcov/

# El backend (Django) no necesita nada de frontend/ en su imagen — sin
# esto, node_modules infla el build context a cientos de MB y en Windows
# puede romper el build por symlinks/archivos que Docker no puede leer.
frontend/node_modules/
frontend/dist/

# Nada de esto va en la imagen del backend: el frontend tiene su propia
# imagen (frontend/Dockerfile), los archivos subidos viven en un volumen y el
# resto son artefactos locales.
frontend/
media/
staticfiles/
loadtests/
celerybeat-schedule
.env.*
!.env.example
Documentación/
*.log
